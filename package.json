{
  "name": "asc-studio",
  "version": "0.6.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs demo",
    "dev:live": "node scripts/dev.mjs live",
    "local": "npm run build && node scripts/local.mjs live",
    "local:demo": "npm run build && node scripts/local.mjs demo",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run start -w @asc-studio/local-agent",
    "start:live": "npm run start:live -w @asc-studio/local-agent"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
